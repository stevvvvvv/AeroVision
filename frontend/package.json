{
  "name": "aerovision-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:demo": "vite --mode demo",
    "build:demo": "tsc -b && vite build --mode demo",
    "deploy": "npm run build:demo && gh-pages -d dist"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "gh-pages": "^6.1.1"
  }
}
